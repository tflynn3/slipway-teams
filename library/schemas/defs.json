{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipway.dev/library/defs.json",
  "title": "Slipway delivery library: shared definitions",
  "description": "IDs, names and text limits shared by every delivery-model schema. Packs inline these at render time.",
  "$defs": {
    "productSlug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}$"},
    "visionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}-vision-v[0-9]+$"},
    "userId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "userJobId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}/UJ[0-9]+$"},
    "releaseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}/[0-9]+[.][0-9]+$"},
    "outcomeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}/[0-9]+[.][0-9]+/O[0-9]+$"},
    "outcomeRef": {"type": "string", "pattern": "^([a-z][a-z0-9-]{2,19}/[0-9]+[.][0-9]+/O[0-9]+)?$"},
    "journeyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}/[0-9]+[.][0-9]+/O[0-9]+/J[0-9]+$"},
    "metricId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "not": {"pattern": "(^|[^A-Za-z])([Mm]ilestone|[Ee]pic|[Ss]print)([^A-Za-z]|$)"}
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "stageBar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass"],
      "properties": {"pass": {"type": "string", "enum": ["all"]}}
    }
  }
}
